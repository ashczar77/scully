# Nebius Token Factory inference
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_INPUT_PRICE_PER_MILLION_USD=0.06
NEBIUS_OUTPUT_PRICE_PER_MILLION_USD=0.24

# Nebius Token Factory Sandboxes
NEBIUS_PROJECT_ID=
CONTREE_PROJECT=

# Tavily
TAVILY_API_KEY=
TAVILY_PROJECT=

# Live probes remain disabled until their budget review is approved.
# Supply attempt-specific limits in the approved execution command.
SCULLY_ENABLE_LIVE=false
SCULLY_LIVE_PROVIDER=
SCULLY_MAX_MODEL_CALLS=1
SCULLY_MAX_INPUT_TOKENS=8192
SCULLY_MAX_OUTPUT_TOKENS=1024
SCULLY_MAX_MODEL_COST_USD=0.01
SCULLY_MAX_TAVILY_CREDITS=1
SCULLY_MAX_SANDBOX_OPERATIONS=1
SCULLY_TIMEOUT_SECONDS=60
