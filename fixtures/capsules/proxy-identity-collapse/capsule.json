  "capsule_id": "proxy-identity-collapse-v2",
  "title": "Reverse-proxy rate-limit identity collapse",
  "observed_summary": "Two synthetic clients enter through a controlled loopback reverse proxy that writes distinct forwarded addresses. With Express proxy trust disabled, both requests still resolve to the proxy socket identity and the second client receives HTTP 429.",
  "failure_signature": {
    "signature_id": "proxy-identity-collapse-v1",
    "matchers": [
      {
        "matcher_id": "response-sequence",
        "kind": "equals",
        "path": ["payload", "responses"],
        "required": true,
        "expected": [200, 429]
      },
      {
        "matcher_id": "rejection-event",
        "kind": "equals",
        "path": ["payload", "events", 1],
        "required": true,
        "expected": "rate_limit_rejected"
      },
      {
        "matcher_id": "collapsed-identity",
        "kind": "same_value",
        "path": ["payload", "identity_digests", 0],
        "comparison_path": ["payload", "identity_digests", 1],
        "required": true
      },
      {
        "matcher_id": "second-forwarded-client",
        "kind": "equals",
        "path": ["payload", "forwarded_clients", 1],
        "required": true,
        "expected": "198.51.100.11"
      },
      {
        "matcher_id": "process-exit",
        "kind": "equals",
        "path": ["exit_code"],
        "required": true,
        "expected": 0
      }
    ]
  },
  "known_good": {
    "description": "Trust only the controlled loopback proxy. The two forwarded clients resolve to distinct identities and both requests return HTTP 200.",
    "observation_evidence_id": "known-good-observation",
    "expected_verdict": "not_reproduced"
  },
